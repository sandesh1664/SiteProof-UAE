{
  "name": "siteproof-uae",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/system.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check public/demo.js && node --check scripts/build-preview.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "test:cloudflare": "npm run build:cloudflare && node --test tests/cloudflare.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
